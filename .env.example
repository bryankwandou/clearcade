# Public devnet endpoint. Any Solana RPC that serves devnet works here.
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com

# Committer key, used only by the scripts in scripts/ and the write route.
# Base58 secret key, or a JSON array of 64 bytes. Never a mainnet key.
SOLANA_DEMO_SECRET=

# Optional: the address the ledger page reads when no key is present.
NEXT_PUBLIC_COMMITTER=
